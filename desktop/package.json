{
  "name": "fatawa-muyassara",
  "productName": "Al-Fatawa Al-Muyassara",
  "version": "1.0.0",
  "description": "الفتاوى الميسّرة — Al-Fatawa Al-Muyassara",
  "author": "Abdul Haseeb Munib",
  "main": "main.js",
  "scripts": { "start": "electron ." },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.abdulhasib.fatawa",
    "productName": "Al-Fatawa Al-Muyassara",
    "files": ["main.js", "package.json"],
    "extraResources": [{ "from": "www", "to": "www" }],
    "asar": true,
    "directories": { "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "icon.png" },
    "nsis": {
      "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true,
      "shortcutName": "Al-Fatawa Al-Muyassara", "artifactName": "FatawaMuyassara-Setup-${version}.exe"
    },
    "mac": {
      "target": [{ "target": "dir", "arch": ["universal"] }], "icon": "icon.png",
      "category": "public.app-category.education", "identity": null, "hardenedRuntime": false
    }
  }
}
